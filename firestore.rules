rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc(request.auth.uid).data.role == "admin";
    }

    function assignedToWorker(workerId) {
      return signedIn()
        && exists(/databases/$(database)/documents/assignments/$(workerId))
        && get(/databases/$(database)/documents/assignments/$(workerId)).data.workerId == workerId
        && get(/databases/$(database)/documents/assignments/$(workerId)).data.active == true
        && (
          get(/databases/$(database)/documents/assignments/$(workerId)).data.managerId == request.auth.uid
          || get(/databases/$(database)/documents/assignments/$(workerId)).data.supporterId == request.auth.uid
        );
    }

    function canReadAssignment() {
      return signedIn()
        && (
          resource.data.workerId == request.auth.uid
          || resource.data.managerId == request.auth.uid
          || resource.data.supporterId == request.auth.uid
          || isAdmin()
        );
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow write: if false;
    }

    match /organizations/{organizationId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /assignments/{assignmentId} {
      allow read: if canReadAssignment();
      allow write: if false;
    }

    match /notificationSchedules/{scheduleId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /notificationEvents/{eventId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /notificationSettings/{userId} {
      allow read: if isSelf(userId);
      allow write: if false;
    }

    match /notificationLogs/{logId} {
      allow read, write: if false;
    }

    match /workerSettings/{userId} {
      allow read: if isSelf(userId) || assignedToWorker(userId) || isAdmin();
      allow write: if false;
    }

    match /reportSchedules/{scheduleId} {
      allow read: if signedIn() && (resource.data.workerId == request.auth.uid || assignedToWorker(resource.data.workerId) || isAdmin());
      allow write: if false;
    }

    match /reportEvents/{eventId} {
      allow read: if signedIn() && (resource.data.workerId == request.auth.uid || assignedToWorker(resource.data.workerId) || isAdmin());
      allow write: if false;
    }

    match /reports/{reportId} {
      allow read: if signedIn() && resource.data.workerId == request.auth.uid;
      allow write: if false;
    }

    match /reportDeliveries/{deliveryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /consultationThreads/{threadId} {
      allow read: if signedIn() && (resource.data.workerId == request.auth.uid || assignedToWorker(resource.data.workerId));
      allow write: if false;
    }

    match /reportReplies/{replyId} {
      allow read, write: if false;
    }

    match /auditLogs/{auditLogId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /modeSwitchRequests/{requestId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || resource.data.requestedSupporterId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /idempotencyKeys/{keyId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
